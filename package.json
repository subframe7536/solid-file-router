{
  "name": "solid-file-router",
  "version": "0.7.0",
  "description": "Type safe file router for solid.js",
  "homepage": "https://github.com/subframe7536/solid-file-router#readme",
  "bugs": {
    "url": "https://github.com/subframe7536/solid-file-router/issues"
  },
  "license": "MIT",
  "author": "subframe7536",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subframe7536/solid-file-router.git"
  },
  "files": [
    "dist",
    "docs",
    "client.d.ts"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./mdx": "./dist/mdx.mjs",
    "./plugin": "./dist/plugin.mjs",
    "./package.json": "./package.json",
    "./client": {
      "types": "./client.d.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest --run",
    "test:dev": "vitest",
    "play": "vite serve playground",
    "play:ssg": "vite serve playground --config ./playground/vite.ssg.config.ts",
    "play:ssg:build": "bun run build && vite build playground --config ./playground/vite.ssg.config.ts",
    "play:ssg:preview": "bun run play:ssg:build && vite preview --outDir playground/dist/client",
    "play:build": "bun run build && vite build playground",
    "play:preview": "bun run play:build && vite preview playground",
    "lint": "oxlint",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "oxc": "oxlint --fix && oxfmt",
    "qa": "bun run oxc && bun run typecheck",
    "release": "bun run build && bun run qa && bun run test && bumpp --all"
  },
  "devDependencies": {
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^1.0.0",
    "@subf/config": "^0.2.1",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.0",
    "bumpp": "^11.1.0",
    "bun-types": "^1.3.14",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "satteri": "^0.9.5",
    "solid-js": "^1.9.14",
    "tinyglobby": "0.2.17",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-solid": "^2.11.13",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@babel/core": "^7.29.7",
    "@solidjs/router": "^1",
    "satteri": "^0.9.5",
    "solid-js": "^1.9.14",
    "tinyglobby": "0.2.17",
    "vite": "^8.1.5",
    "yaml": "^2.9.0"
  },
  "peerDependenciesMeta": {
    "satteri": {
      "optional": true
    },
    "yaml": {
      "optional": true
    }
  }
}
