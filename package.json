{
  "name": "solid-file-router",
  "version": "1.0.0",
  "description": "Type safe file router for solid.js",
  "homepage": "https://github.com/subframe7536/solid-file-router#readme",
  "bugs": {
    "url": "https://github.com/subframe7536/solid-file-router/issues"
  },
  "license": "MIT",
  "author": "subframe7536",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subframe7536/solid-file-router.git"
  },
  "files": [
    "dist",
    "docs",
    "client.d.ts"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./mdx": "./dist/mdx.mjs",
    "./plugin": "./dist/plugin.mjs",
    "./package.json": "./package.json",
    "./client": {
      "types": "./client.d.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest --run",
    "test:dev": "vitest",
    "play": "vite serve playground",
    "play:ssg": "vite serve playground --config ./playground/vite.ssg.config.ts",
    "play:ssg:build": "pnpm build && vite build playground --config ./playground/vite.ssg.config.ts",
    "play:ssg:preview": "pnpm play:ssg:build && vite preview --config ./playground/vite.ssg.config.ts --outDir playground/dist/client",
    "play:build": "pnpm build && vite build playground",
    "play:preview": "pnpm play:build && vite preview playground",
    "lint": "oxlint",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "oxc": "oxlint --fix && oxfmt",
    "qa": "pnpm oxc && pnpm typecheck",
    "release": "pnpm build && pnpm qa && pnpm test && bumpp --all"
  },
  "devDependencies": {
    "@solidjs/router": "2.0.0-next.44",
    "@solidjs/vite-plugin": "3.0.0-next.35",
    "@solidjs/web": "2.0.0-rc.21",
    "@subf/config": "^0.5.0",
    "@types/node": "^26.6.6",
    "bumpp": "^12.3.0",
    "filesystem-routing": "^0.5.0",
    "jsdom": "^31.0.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "satteri": "^0.11.7",
    "solid-js": "2.0.0-rc.21",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@solidjs/router": "2.0.0-next.44",
    "@solidjs/web": "^2.0.0-rc.0",
    "filesystem-routing": "^0.5.0",
    "satteri": "^0.11.7",
    "solid-js": "^2.0.0-rc.0",
    "vite": "^8.1.5",
    "yaml": "^2.9.1"
  },
  "peerDependenciesMeta": {
    "satteri": {
      "optional": true
    },
    "yaml": {
      "optional": true
    }
  },
  "packageManager": "pnpm@12.6.0"
}
