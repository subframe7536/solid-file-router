{
  "name": "solid-file-router",
  "version": "0.1.8",
  "description": "Type safe file router for solid.js",
  "homepage": "https://github.com/subframe7536/solid-file-router#readme",
  "bugs": {
    "url": "https://github.com/subframe7536/solid-file-router/issues"
  },
  "license": "MIT",
  "author": "subframe7536",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subframe7536/solid-file-router.git"
  },
  "files": [
    "dist",
    "client.d.ts"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./plugin": "./dist/plugin.mjs",
    "./package.json": "./package.json",
    "./client": {
      "types": "./client.d.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "bun --bun tsdown --watch",
    "test": "bun --bun vitest",
    "test:run": "bun --bun vitest --run",
    "play": "bun --bun vite serve playground",
    "play:build": "bun run build && bun --bun vite build playground",
    "play:preview": "bun --bun vite preview playground",
    "lint": "bun --bun oxlint",
    "format": "bun --bun oxfmt",
    "typecheck": "bun --bun tsc --noEmit",
    "fix-oxlint": "bun -e \"const p=process.argv[1],f=Bun.file(p),t=await f.text();await Bun.write(p,t.replace(/jsPlugins/g,'//jsPlugins'));await Bun.write(p,t)\" .oxlintrc.json",
    "oxc": "bun --bun oxlint --fix && bun --bun oxfmt",
    "qa": "bun run --parallel oxc typecheck",
    "release": "bun run build && bun run lint && bun run test:run && bumpp",
    "init": "bun link && bun i && bun run build"
  },
  "devDependencies": {
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^0.15.4",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.12.0",
    "bumpp": "^10.4.1",
    "bun-types": "^1.3.10",
    "eslint-plugin-solid": "^0.14.5",
    "oxfmt": "^0.40.0",
    "oxlint": "^1.55.0",
    "solid-js": "^1.9.11",
    "tinyglobby": "*",
    "tsdown": "^0.21.3",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vite-plugin-solid": "^2.11.11",
    "vitest": "^4.1.0"
  },
  "peerDependencies": {
    "@babel/core": "^7.29.0",
    "@solidjs/router": ">=0.10.0 <1",
    "solid-js": "^1.9.11",
    "tinyglobby": "*",
    "vite": "^8.0.0"
  }
}
